---
import { documentUrl } from "../lib/data";
import type { Document } from "../lib/data";

interface Props {
  documents: Document[];
}

const { documents } = Astro.props;
const kindLabels: Record<string, string> = {
  concept: "개념",
  entity: "개체",
  analysis: "분석",
  source: "소스",
  reference: "참고 자료",
  meta: "운영"
};
---

<div class="doc-list">
  {documents.map((document) => (
    <a class="doc-row" href={documentUrl(document)}>
      <div>
        <span class="doc-kind">{kindLabels[document.kind] || document.kind}</span>
        <h3>{document.title}</h3>
        <p>{document.summary}</p>
      </div>
      <span class="doc-arrow" aria-hidden="true">→</span>
    </a>
  ))}
</div>
