---
import Base from "../layouts/Base.astro";
import DocumentList from "../components/DocumentList.astro";
import { graph, publicDocuments, withBase } from "../lib/data";

const recent = [...publicDocuments]
  .sort((a, b) => b.updated.localeCompare(a.updated) || a.title.localeCompare(b.title))
  .slice(0, 6);
---

<Base
  title="CS Wiki"
  description="컴퓨터 과학의 역사·이론·시스템을 원본과 지식 연결로 읽는 위키"
  canonical={withBase("/")}
>
  <p class="eyebrow">Knowledge graph wiki</p>
  <h1>계산의 역사와 구조를<br />연결해서 읽기</h1>
  <p class="lede">
    문서는 원본을 근거로 쓰고, 관계는 frontmatter에, 그래프는 빌드 시 정규화합니다.
    440개 문서와 887개 관계를 같은 언어로 탐색합니다.
  </p>

  <div class="stat-grid">
    <div class="stat"><strong>440</strong><span>문서</span></div>
    <div class="stat"><strong>397</strong><span>공개 문서</span></div>
    <div class="stat"><strong>887</strong><span>관계 statement</span></div>
    <div class="stat"><strong>440</strong><span>Registry nodes</span></div>
  </div>

  <h2>최근 문서</h2>
  <DocumentList documents={recent} />

  <h2>탐색</h2>
  <div class="grid">
    <a class="card" href={withBase("/index/")}>
      <h3>전체 색인</h3>
      <p>유형과 주제별로 397개 공개 문서를 찾습니다.</p>
    </a>
    <a class="card" href={withBase("/search/")}>
      <h3>검색</h3>
      <p>제목·요약·별칭·주제로 397개 공개 문서를 찾습니다.</p>
    </a>
    <a class="card" href={withBase("/history/")}>
      <h3>역사 렌즈</h3>
      <p>근거가 있는 연도만 시간축에 배치합니다.</p>
    </a>
    <a class="card" href={withBase("/evidence/")}>
      <h3>근거 렌즈</h3>
      <p>어떤 소스가 어떤 관계를 뒷받침하는지 추적합니다.</p>
    </a>
  </div>
</Base>
