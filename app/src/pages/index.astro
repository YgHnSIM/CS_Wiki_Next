---
import Base from "../layouts/Base.astro";
import "../styles/legacy-home.css";
import { documentUrl, graph, publicDocuments, withBase } from "../lib/data";

const kindLabels: Record<string, string> = {
  concept: "개념",
  entity: "개체",
  analysis: "분석",
  source: "소스",
  reference: "참고 자료",
  meta: "운영"
};
const counts = publicDocuments.reduce((accumulator, document) => {
  accumulator[document.kind] = (accumulator[document.kind] || 0) + 1;
  return accumulator;
}, {} as Record<string, number>);

const degree = new Map<string, number>();
for (const statement of graph.statements) {
  degree.set(statement.subject, (degree.get(statement.subject) || 0) + 1);
  degree.set(statement.target, (degree.get(statement.target) || 0) + 1);
}

const featured = publicDocuments
  .filter((document) => document.kind === "analysis")
  .sort((a, b) => (degree.get(b.key) || 0) - (degree.get(a.key) || 0) || a.title.localeCompare(b.title, "ko"))
  .slice(0, 3);

const recent = publicDocuments
  .filter((document) => document.kind !== "meta")
  .sort((a, b) => b.updated.localeCompare(a.updated) || a.title.localeCompare(b.title, "ko"))
  .slice(0, 5);

const domainCounts = new Map<string, number>();
for (const document of publicDocuments) {
  for (const domain of document.domains) domainCounts.set(domain, (domainCounts.get(domain) || 0) + 1);
}
const domainLabels: Record<string, string> = {
  "computer-history": "컴퓨터 역사",
  "software-engineering": "소프트웨어 공학",
  "computer-science": "컴퓨터 과학",
  "programming-languages": "프로그래밍 언어",
  "computer-architecture": "컴퓨터 구조",
  "text-processing": "텍스트 처리",
  "operating-systems": "운영체제",
  security: "보안",
  systems: "시스템",
  database: "데이터베이스",
  "distributed-systems": "분산 시스템",
  "edge-computing": "엣지 컴퓨팅",
  performance: "성능",
  internet: "인터넷",
  mathematics: "수학",
  "machine-learning": "기계 학습",
  web: "웹"
};
const domains = [...domainCounts.entries()].sort((a, b) => b[1] - a[1]).slice(0, 6);

const routes = ["concept", "entity", "analysis", "source", "reference"].map((kind) => ({
  kind,
  label: kindLabels[kind] || kind,
  count: counts[kind] || 0,
  href: `${withBase("/index/")}#${kind}`
}));

const startEntries = [
  { kind: "concept", document: publicDocuments.find((document) => document.key === "concept:computing-capability") },
  { kind: "entity", document: publicDocuments.find((document) => document.key === "person:alan-turing") },
  { kind: "analysis", document: featured[0] }
].filter((entry) => Boolean(entry.document));

---

<Base
  title="CS Wiki"
  description="컴퓨터 과학의 역사·이론·시스템을 원본과 지식 연결로 읽는 위키"
  canonical={withBase("/")}
  wide
  bodyClass="home-page"
>
  <div class="legacy-home">
    <section class="hero section-frame">
      <div class="hero-copy">
        <p class="eyebrow">정규 소스 {counts.source || 0} · 참고 자료 {counts.reference || 0} · 공개 문서 {publicDocuments.length}</p>
        <h1>
          <span class="hero-title-line hero-title-primary">컴퓨팅의 역사를</span>
          <span class="hero-title-line hero-title-accent">연결해서 읽는다.</span>
        </h1>
        <p class="hero-intro">
          배비지와 러브레이스에서 저장 프로그램 컴퓨터, 구조적 프로그래밍, Unix와 C, 유니코드까지.
          원본 문헌에서 출발해 개념과 분석을 잇는 기술 위키입니다.
        </p>
        <div class="hero-actions">
          <a class="primary-action" href={withBase("/search/")}>문서 검색</a>
          <a href={withBase("/index/")}>전체 색인 보기</a>
        </div>
        <dl class="hero-stats">
          <div><dt>공개 문서</dt><dd>{publicDocuments.length}</dd></div>
          <div><dt>개념</dt><dd>{counts.concept || 0}</dd></div>
          <div><dt>관계</dt><dd>{graph.statements.length}</dd></div>
          <div><dt>핵심 분석</dt><dd>{counts.analysis || 0}</dd></div>
        </dl>
      </div>

      <aside class="hero-start" aria-labelledby="hero-start-title">
        <header class="hero-start-heading">
          <span>START HERE</span>
          <h2 id="hero-start-title">먼저 읽을 세 가지</h2>
        </header>
        <ol>
          {startEntries.map((entry, index) => (
            <li>
              <a href={documentUrl(entry.document!)}>
                <span class="hero-start-index">{String(index + 1).padStart(2, "0")}</span>
                <span class="hero-start-kind">{kindLabels[entry.kind] || entry.kind}</span>
                <strong>{entry.document!.title}</strong>
                <small>{entry.document!.summary}</small>
              </a>
            </li>
          ))}
        </ol>
        <a class="hero-start-all" href={withBase("/index/")}>전체 색인에서 더 찾기 <span>→</span></a>
      </aside>
    </section>

    <section class="home-directory content-section">
      <div class="section-heading">
        <span>01</span>
        <div><h2>읽기 시작</h2><p>자료 유형을 고르거나, 여러 문헌을 잇는 분석부터 읽습니다.</p></div>
      </div>
      <div class="home-directory-grid">
        <section class="home-panel" aria-labelledby="home-routes-title">
          <header class="home-panel-heading">
            <div><span>DIRECTORY</span><h3 id="home-routes-title">자료 유형별 색인</h3></div>
            <a href={withBase("/index/")}>전체 {publicDocuments.length}개</a>
          </header>
          <div class="home-route-list">
            {routes.map((route, index) => (
              <a class="route-card" href={route.href}>
                <span class="route-index">{String(index + 1).padStart(2, "0")}</span>
                <h3>{route.label}</h3>
                <p>{route.count}개 문서</p>
              </a>
            ))}
          </div>
        </section>

        <section class="home-panel" aria-labelledby="home-analysis-title">
          <header class="home-panel-heading">
            <div><span>SYNTHESIS</span><h3 id="home-analysis-title">핵심 분석</h3></div>
            <a href={withBase("/index/#analysis")}>전체 {counts.analysis || 0}개</a>
          </header>
          <ol class="home-feature-list">
            {featured.map((document, index) => (
              <li>
                <span>{String(index + 1).padStart(2, "0")}</span>
                <a href={documentUrl(document)}><strong>{document.title}</strong><small>{document.summary}</small></a>
              </li>
            ))}
          </ol>
        </section>
      </div>
    </section>

    <section class="home-briefing content-section">
      <div class="section-heading">
        <span>02</span>
        <div><h2>지금 위키의 범위</h2><p>주제 분포와 최근 갱신을 한 화면에서 확인합니다.</p></div>
      </div>
      <div class="home-briefing-grid">
        <section class="home-panel home-scope" aria-labelledby="home-scope-title">
          <header class="home-panel-heading">
            <div><span>SCOPE</span><h3 id="home-scope-title">지식 범위</h3></div>
          </header>
          <div class="home-scope-grid">
            {domains.map(([domain, count]) => (
              <div><span>{domainLabels[domain] || domain}</span><strong>{count}</strong></div>
            ))}
          </div>
          <p>관련 원본 소스가 추가될 때 같은 출처 검증 절차로 범위를 확장합니다.</p>
        </section>

        <aside class="home-panel home-recent" aria-labelledby="home-recent-title">
          <header class="home-panel-heading">
            <div><span>UPDATED</span><h3 id="home-recent-title">최근 갱신</h3></div>
          </header>
          <ol>
            {recent.map((document) => (
              <li><a href={documentUrl(document)}><span>{document.title}</span><time>{document.updated}</time></a></li>
            ))}
          </ol>
        </aside>
      </div>
    </section>
  </div>
</Base>
