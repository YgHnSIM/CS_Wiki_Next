---
import Base from "../layouts/Base.astro";
import { documentUrl, graph, nodeDocument } from "../lib/data";

const degree = new Map<string, number>();
for (const statement of graph.statements) {
  degree.set(statement.subject, (degree.get(statement.subject) || 0) + 1);
  degree.set(statement.target, (degree.get(statement.target) || 0) + 1);
}
const top = [...degree.entries()]
  .map(([key, value]) => ({ key, value, document: nodeDocument(key) }))
  .filter((item) => item.document)
  .sort((a, b) => b.value - a.value || a.key.localeCompare(b.key))
  .slice(0, 40);
---

<Base title="지식 지도" description="CS Wiki 지식 그래프의 연결 분포">
  <p class="eyebrow">Map</p>
  <h1>지식 지도</h1>
  <p class="lede">887개 statement와 440개 노드의 연결 분포입니다. 노드를 선택하면 해당 문서로 이동합니다.</p>

  <div class="stat-grid">
    <div class="stat"><strong>{graph.nodes.length}</strong><span>nodes</span></div>
    <div class="stat"><strong>{graph.statements.length}</strong><span>statements</span></div>
    <div class="stat"><strong>{top.length}</strong><span>상위 연결 노드</span></div>
  </div>

  <h2>연결이 많은 노드</h2>
  <ol class="list-plain">
    {top.map((item) => (
      <li>
        <a href={documentUrl(item.document!)}>{item.document!.title}</a>
        <small> · {item.document!.kind} · degree {item.value}</small>
      </li>
    ))}
  </ol>
</Base>
