---
import Base from "../../layouts/Base.astro";
import DocumentList from "../../components/DocumentList.astro";
import { publicDocuments } from "../../lib/data";

const kindLabels: Record<string, string> = {
  concept: "개념",
  entity: "개체",
  analysis: "분석",
  source: "소스",
  reference: "참고 자료"
};
const groups = new Map<string, typeof publicDocuments>();
for (const document of publicDocuments) {
  if (!groups.has(document.kind)) groups.set(document.kind, []);
  groups.get(document.kind)!.push(document);
}
for (const documents of groups.values()) documents.sort((a, b) => a.title.localeCompare(b.title, "ko"));
---

<Base title="전체 색인" description="CS Wiki의 공개 문서 전체 색인">
  <p class="eyebrow">Index</p>
  <h1>전체 색인</h1>
  <p class="lede">공개 문서 {publicDocuments.length}개를 유형별로 정렬했습니다. unlisted 문서는 이 목록에 나오지 않습니다.</p>

  {[...groups.entries()].sort(([a], [b]) => a.localeCompare(b)).map(([kind, documents]) => (
    <section>
      <h2>{kindLabels[kind] || kind} <small>({documents.length})</small></h2>
      <DocumentList documents={documents} />
    </section>
  ))}
</Base>
