---
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
  canonical?: string;
  noindex?: boolean;
  refresh?: string;
}

const { title, description = "", canonical, noindex = false, refresh } = Astro.props;
const base = import.meta.env.BASE_URL || "/";
const site = Astro.site || new URL("http://localhost:4321");
const canonicalHref = canonical
  ? new URL(canonical, site).href
  : new URL(Astro.url.pathname, site).href;
const nav = [
  ["색인", `${base}index/`],
  ["지도", `${base}map/`],
  ["역사", `${base}history/`],
  ["근거", `${base}evidence/`],
  ["검색", `${base}search/`]
];
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#0A0014" />
    <title>{title} · CS Wiki</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalHref} />
    {refresh && <meta http-equiv="refresh" content={`0; url=${refresh}`} />}
    {noindex && <meta name="robots" content="noindex" />}
    <meta property="og:title" content={`${title} · CS Wiki`} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
  </head>
  <body>
    <a class="skip-link" href="#main">본문으로 건너뛰기</a>
    <header class="site-header">
      <div class="shell header-inner">
        <a class="brand" href={base}>
          <span class="brand-mark">CS</span>
          <span>CS Wiki</span>
        </a>
        <nav class="site-nav" aria-label="주요 탐색">
          {nav.map(([label, href]) => (
            <a href={href}>{label}</a>
          ))}
        </nav>
      </div>
    </header>
    <main id="main" class="shell">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="shell footer-inner">
        <span>CS Wiki Next · 지식 그래프 기반 정적 위키</span>
        <span>440 documents · 887 statements</span>
      </div>
    </footer>
  </body>
</html>
