---
import "../styles/global.css";
import { documents, graph, publicDocuments, withBase } from "../lib/data";
import { traces } from "../lib/traces";

interface Props {
  title: string;
  description?: string;
  canonical?: string;
  noindex?: boolean;
  refresh?: string;
  wide?: boolean;
  bodyClass?: string;
}

const { title, description = "", canonical, noindex = false, refresh, wide = false, bodyClass = "" } = Astro.props;
const base = import.meta.env.BASE_URL || "/";
const site = Astro.site || new URL("http://localhost:4321");
const canonicalHref = canonical ? new URL(canonical, site).href : new URL(Astro.url.pathname, site).href;
const currentPath = Astro.url.pathname;
const sections = ["concept", "entity", "analysis", "source", "reference", "meta"];
const labels: Record<string, string> = {
  concept: "concepts",
  entity: "entities",
  analysis: "analyses",
  source: "sources",
  reference: "references",
  meta: "meta"
};
const counts = publicDocuments.reduce((accumulator, document) => {
  accumulator[document.kind] = (accumulator[document.kind] || 0) + 1;
  return accumulator;
}, {} as Record<string, number>);
const section = currentPath.includes("/docs/") ? "docs" : currentPath.split("/").filter(Boolean)[0] || "home";
const fileLabel = title === "CS Wiki" ? "welcome.md" : `${title}.md`;
const pageTitle = title === "CS Wiki" ? "CS Wiki" : `${title} · CS Wiki`;
const isNotFound = currentPath.endsWith("/404/") || currentPath.endsWith("/404.html");
const tabHref = isNotFound ? base : currentPath;
const activeView = currentPath.includes("/search/") ? "search" : currentPath.includes("/history/") ? "history" : currentPath.includes("/evidence/") ? "evidence" : currentPath.includes("/traces/") ? "traces" : "explorer";
const traceCommands = traces.map((trace) => ({
  title: `Trace: ${trace.title}`,
  summary: trace.question,
  kind: "trace",
  aliases: [trace.id],
  url: withBase(`/traces/${trace.id}/`)
}));
const guideCommands = [
  { title: "Guide: 이 위키를 읽는 법", summary: "source·concept·analysis 읽기", kind: "guide", aliases: ["reading guide"], url: withBase("/guides/reading/") },
  { title: "Guide: 근거와 관계 읽기", summary: "evidence·relations·연도", kind: "guide", aliases: ["evidence guide"], url: withBase("/guides/evidence/") }
];
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#1e1e1e" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalHref} />
    <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600;700&family=Noto+Sans+KR:wght@400;500;700&display=swap"
      rel="stylesheet"
    />
    {refresh && <meta http-equiv="refresh" content={`0; url=${refresh}`} />}
    {noindex && <meta name="robots" content="noindex" />}
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
  </head>
  <body class={bodyClass}>
    <a class="skip-link" href="#editor">본문으로 건너뛰기</a>
    <div class="workbench">
      <aside class="activity-bar" aria-label="활동 표시줄">
        <a class="activity-brand" href={base} aria-label="CS Wiki 홈">CS</a>
        <nav class="activity-nav">
          <a href={withBase("/index/")} aria-label="탐색기" title="Explorer" aria-current={activeView === "explorer" ? "page" : undefined}>▤</a>
          <button type="button" data-command-open aria-label="검색" title="Search" aria-current={activeView === "search" ? "page" : undefined}>⌕</button>
          <a href={withBase("/traces/")} aria-label="읽기 트레이스" title="Reading Traces" aria-current={activeView === "traces" ? "page" : undefined}>⤳</a>
          <a href={withBase("/history/")} aria-label="역사" title="History" aria-current={activeView === "history" ? "page" : undefined}>◷</a>
          <a href={withBase("/evidence/")} aria-label="근거" title="Evidence" aria-current={activeView === "evidence" ? "page" : undefined}>◈</a>
        </nav>
        <button class="activity-command" type="button" data-command-open aria-label="명령 팔레트" title="Command Palette">⌘</button>
      </aside>

      <aside class="sidebar" aria-label="탐색기">
        <div class="sidebar-section">EXPLORER</div>
        <div class="tree">
          <a class="tree-root" href={base}>▾ CS_WIKI</a>
          {sections.map((kind) => (
            <a class="tree-item" href={`${withBase("/index/")}#${kind}`}>
              <span class="tree-icon">{kind === "source" || kind === "reference" ? "▤" : "◇"}</span>
              <span>{labels[kind]}</span>
              <span class="tree-count">{counts[kind] || 0}</span>
            </a>
          ))}
        </div>
        <div class="sidebar-section">OPEN EDITORS</div>
        <a class="open-editor active" href={tabHref}>
          <span class="dot"></span>
          <span>{fileLabel}</span>
        </a>
        <div class="sidebar-section">TRACES</div>
        {traces.map((trace) => (
          <a class="tree-item" href={withBase(`/traces/${trace.id}/`)} title={trace.title}>
            <span class="tree-icon">⤳</span>
            <span>{trace.title}</span>
          </a>
        ))}
        <div class="sidebar-section">GUIDES</div>
        <a class="tree-item" href={withBase("/guides/reading/")}><span class="tree-icon">?</span><span>이 위키를 읽는 법</span></a>
        <a class="tree-item" href={withBase("/guides/evidence/")}><span class="tree-icon">?</span><span>근거와 관계 읽기</span></a>
        <div class="sidebar-section">SHORTCUTS</div>
        <button class="sidebar-shortcut" type="button" data-command-open>
          <span>Command Palette</span><kbd>Ctrl K</kbd>
        </button>
        <a class="sidebar-shortcut" href={withBase("/search/")}>
          <span>Search</span><kbd>/</kbd>
        </a>
      </aside>

      <main class="editor" id="editor">
        <div class="tabbar">
          <a class="tab active" href={tabHref}>
            <span class="tab-file">◇</span>
            <span>{fileLabel}</span>
            <span class="tab-close" aria-hidden="true">×</span>
          </a>
          <a class="tab muted" href={withBase("/index/")}>
            <span class="tab-file">▤</span>
            <span>index.md</span>
          </a>
        </div>
        <div class="breadcrumb" aria-label="경로">
          <a href={base}>CS_Wiki</a><span>/</span><span>{section}</span><span>/</span><span>{fileLabel}</span>
        </div>
        <div class="editor-scroll">
          <slot />
        </div>
      </main>
    </div>

    <footer class="statusbar" aria-label="상태 표시줄">
      <span>⑂ main</span>
      <span>CS Wiki</span>
      <span>{documents.length} docs</span>
      <span>{graph.statements.length} statements</span>
      <span>UTF-8</span>
      <span>LF</span>
      {noindex && <span class="status-warning">noindex</span>}
    </footer>

    <div class="command-backdrop" data-command-palette data-traces={JSON.stringify(traceCommands)} data-guides={JSON.stringify(guideCommands)} hidden>
      <div class="command" role="dialog" aria-modal="true" aria-label="명령 팔레트">
        <input
          type="search"
          class="command-input"
          placeholder="문서 검색..."
          aria-label="문서 검색"
          data-command-input
          data-base={withBase("/")}
          aria-controls="command-results"
          aria-activedescendant=""
          autocomplete="off"
        />
        <div class="command-results" id="command-results" data-command-results role="listbox"></div>
        <div class="command-footer"><span>↑↓ 이동</span><span>Enter 열기</span><span>Esc 닫기</span></div>
      </div>
    </div>

    <script>
      import { rankSearch } from "../lib/search.mjs";

      const palette = document.querySelector("[data-command-palette]");
      const commandInput = document.querySelector("[data-command-input]");
      const commandResults = document.querySelector("[data-command-results]");
      const traceIndex = JSON.parse(palette.dataset.traces || "[]");
      const guideIndex = JSON.parse(palette.dataset.guides || "[]");
      let commandIndex = [];
      let selected = 0;
      let lastFocus = null;

      if (palette && commandInput && commandResults) {
        const open = () => {
          lastFocus = document.activeElement;
          palette.hidden = false;
          commandInput.value = "";
          render("");
          commandInput.focus();
          if (!commandIndex.length) {
            fetch(`${commandInput.dataset.base}search.json`)
              .then((response) => response.json())
              .then((data) => { commandIndex = data; render(commandInput.value); })
              .catch(() => { render(commandInput.value); });
          }
        };
        const close = () => {
          palette.hidden = true;
          if (lastFocus instanceof HTMLElement) lastFocus.focus();
        };
        const render = (query) => {
          const trimmed = query.trim();
          const pathItems = trimmed
            ? rankSearch([...traceIndex, ...guideIndex], trimmed).slice(0, 4).map((entry) => entry.item)
            : [...traceIndex, ...guideIndex];
          const docItems = trimmed
            ? rankSearch(commandIndex, trimmed).slice(0, 12).map((entry) => entry.item)
            : [];
          selected = 0;
          commandResults.replaceChildren();
          const links = [];
          const appendGroup = (label, items) => {
            if (!items.length) return;
            const group = document.createElement("div");
            group.className = "command-group";
            const heading = document.createElement("div");
            heading.className = "command-group-title";
            heading.textContent = label;
            group.append(heading);
            for (const item of items) {
              const link = document.createElement("a");
              link.href = item.url;
              link.id = `command-result-${links.length}`;
              link.setAttribute("role", "option");
              link.setAttribute("aria-selected", "false");
              const title = document.createElement("span");
              title.textContent = item.title;
              const small = document.createElement("small");
              small.textContent = `${item.kind} · ${item.url}`;
              link.append(title, small);
              links.push(link);
              group.append(link);
            }
            commandResults.append(group);
          };
          appendGroup("PATHS", pathItems);
          appendGroup("DOCUMENTS", docItems);
          if (!links.length) commandResults.textContent = "일치하는 문서가 없습니다.";
          select(0);
        };
        const select = (next) => {
          const links = [...commandResults.querySelectorAll("a")];
          if (!links.length) {
            commandInput.setAttribute("aria-activedescendant", "");
            return;
          }
          selected = (next + links.length) % links.length;
          links.forEach((link, index) => {
            link.classList.toggle("selected", index === selected);
            link.setAttribute("aria-selected", String(index === selected));
          });
          commandInput.setAttribute("aria-activedescendant", links[selected].id);
          links[selected].scrollIntoView({ block: "nearest" });
        };

        document.querySelectorAll("[data-command-open]").forEach((button) => button.addEventListener("click", open));
        document.addEventListener("keydown", (event) => {
          if ((event.ctrlKey || event.metaKey) && (event.key.toLowerCase() === "k" || (event.shiftKey && event.key.toLowerCase() === "p"))) {
            event.preventDefault();
            open();
          }
          if (palette.hidden) return;
          if (event.key === "Tab") {
            const links = [...commandResults.querySelectorAll("a")];
            const focusables = [commandInput, ...links];
            const current = focusables.indexOf(document.activeElement);
            event.preventDefault();
            const next = event.shiftKey ? (current <= 0 ? focusables.length - 1 : current - 1) : (current + 1) % focusables.length;
            focusables[next].focus();
          }
          if (event.key === "Escape") close();
          if (event.key === "ArrowDown") { event.preventDefault(); select(selected + 1); }
          if (event.key === "ArrowUp") { event.preventDefault(); select(selected - 1); }
          if (event.key === "Enter") {
            const link = commandResults.querySelectorAll("a")[selected];
            if (link) window.location.href = link.href;
          }
        });
        commandInput.addEventListener("input", () => render(commandInput.value));
        palette.addEventListener("click", (event) => { if (event.target === palette) close(); });
      }
    </script>
  </body>
</html>
