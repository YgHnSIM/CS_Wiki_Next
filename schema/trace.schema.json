{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cswiki.local/schema/trace.schema.json",
  "title": "CS Wiki Reading Trace catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "traces"],
  "properties": {
    "schema_version": { "const": 1 },
    "traces": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "question", "outcome", "audience", "minutes", "prerequisites", "steps", "branches"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
          "title": { "type": "string", "minLength": 1 },
          "question": { "type": "string", "minLength": 1 },
          "outcome": { "type": "string", "minLength": 1 },
          "audience": { "type": "string", "minLength": 1 },
          "minutes": { "type": "integer", "minimum": 5, "maximum": 180 },
          "prerequisites": { "type": "array", "items": { "type": "string" } },
          "steps": {
            "type": "array",
            "minItems": 3,
            "maxItems": 8,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["document", "role", "why", "checkpoint"],
              "properties": {
                "document": { "type": "string", "minLength": 1 },
                "role": { "enum": ["source", "concept", "analysis", "entity"] },
                "why": { "type": "string", "minLength": 1 },
                "checkpoint": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["question", "answer", "evidence"],
                  "properties": {
                    "question": { "type": "string", "minLength": 1 },
                    "answer": { "type": "string", "minLength": 1 },
                    "evidence": { "type": "array", "minItems": 1, "items": { "type": "string" } }
                  }
                }
              }
            }
          },
          "branches": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "label", "documents"],
              "properties": {
                "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
                "label": { "type": "string", "minLength": 1 },
                "documents": { "type": "array", "minItems": 1, "items": { "type": "string" } }
              }
            }
          }
        }
      }
    }
  }
}
